# Copie para .env (que o Git ignora) e ajuste.

# Conta do dono, criada na primeira vez que a API sobe. É com ela que você entra em /admin.
# A senha precisa ter 10 caracteres ou mais. Depois de criada, mudar aqui não troca a senha.
OWNER_EMAIL=dono@exemplo.com
OWNER_PASSWORD=troque-por-uma-senha-longa

# Nome e contato que aparecem no site e nos e-mails (opcional).
SHOP_NAME=Barbearia Navalha
SHOP_ADDRESS=
SHOP_PHONE=

POSTGRES_PASSWORD=barbearia

# Opcional: RATE_LIMIT=off desliga o limite de tentativas por IP (demonstrações).
# Atrás de nginx/balanceador: TRUST_PROXY_HOPS=1 (padrão). Use 0 se a API ficar exposta direto.

# E-mail: sem SMTP_URL, o Docker usa a caixa de teste (http://localhost:8025).
# Para enviar e-mails de verdade, aponte para o seu provedor, por exemplo:
# SMTP_URL=smtp://usuario:senha@smtp.seuprovedor.com:587
# MAIL_FROM=Barbearia Navalha <contato@seudominio.com.br>
